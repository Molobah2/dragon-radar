# Copy to .env for local runs. Never commit real values.

# From the X developer console (console.x.com) > your app > Keys and tokens > Bearer token
X_BEARER_TOKEN=

# Supabase: Project settings > Database > Connection string (URI). Local default is SQLite.
DATABASE_URL=sqlite:///radar.db

SITE_NAME="Dragon Radar"
SEARCH_QUERY="(@Pocket_Dragons_ OR from:Pocket_Dragons_) -is:reply -is:retweet"
TEAM_HANDLE=Pocket_Dragons_
# Optional: skips one $0.01 user lookup on the first run
TEAM_USER_ID=
TIMEZONE=Africa/Accra

# Collector stops before going over this estimated monthly spend
MONTHLY_SPEND_LIMIT_USD=50
MAX_PAGES_PER_RUN=10
FIRST_RUN_BACKFILL_HOURS=24

# Admin page is disabled until both are set. Use long random values.
ADMIN_PASSWORD=
SECRET_KEY=

# Local preview only: placeholder cards instead of X embeds
DEMO_MODE=0
